# 当前 config.py 导入时会校验以下四项均非空，即使所运行模块不使用其中某项。
# LLM密钥
OPENAI_API_KEY=your_openai_api_key

# LangSmith 相关配置（用于调试/监控 LangGraph 流程）
LANGCHAIN_API_KEY=your_langsmith_api_key

# 高德地图相关配置（用于 MCP 服务调试）
AMAP_MAPS_API_KEY=your_gaode_api_key

# ChatGPT密钥（用于 Agents SDK 对接 Smith 追踪）
CHATGPT_API_KEY=your_chatgpt_api_key

# 可选：模块11中需要 Bearer Header 的远端 Streamable HTTP MCP 示例
# MCP_HTTP_URL=https://example.com/mcp
# MCP_BEARER_TOKEN=your_mcp_api_key
